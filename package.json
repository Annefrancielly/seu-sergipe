{
  "name": "seu-sergipe",
  "version": "0.1.0",
  "private": true,
  "description": "Website oficial do Seu Sergipe — Casa de Cultura & Arte Gastronômica",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npm run build && wrangler dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.3"
  }
}
