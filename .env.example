# Copie para .env.local no desenvolvimento. Na Vercel, configure em
# Project Settings > Environment Variables. Nenhuma destas variáveis é secreta.

# Endereço público do site, sem barra final. Na falta dele, o site usa o
# domínio de produção da Vercel (VERCEL_PROJECT_PRODUCTION_URL).
SITE_URL=

# "on" libera a indexação pelos buscadores. Só tem efeito no ambiente de
# produção da Vercel. Ative apenas no lançamento.
SITE_INDEXING=
