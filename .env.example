# Copie para .env.local no desenvolvimento. Na Cloudflare, configure em
# Workers & Pages > seu-sergipe > Settings > Build > Variables and secrets.
# Nenhuma destas variáveis é secreta; todas são lidas apenas durante o build.

# Endereço público do site, sem barra final. Obrigatório no build de produção.
# Ex.: https://seu-sergipe.SUA-CONTA.workers.dev ou https://www.dominio.com.br
SITE_URL=

# "on" libera a indexação pelos buscadores. Só tem efeito em produção.
# Ative apenas no lançamento.
SITE_INDEXING=

# Opcional. Força o ambiente ("production" ou "preview"). Sem ela, a produção
# é reconhecida pela branch main (WORKERS_CI_BRANCH, definida pela Cloudflare).
SITE_ENV=
